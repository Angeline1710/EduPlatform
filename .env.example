# ─── Database (Vercel Postgres / Neon) ────────────────────────────────────────
# Get this from: Vercel Dashboard → Storage → Postgres → .env.local tab
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
# Set to your Vercel deployment URL in production (e.g. https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# ─── Seed admin account (used by `npm run seed`) ──────────────────────────────
ADMIN_NAME="Your Name"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"
