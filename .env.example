# ─── Database (Vercel Postgres / Neon) ────────────────────────────────────────
# Get this from: Vercel Dashboard → Storage → Postgres → .env.local tab
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
# Leave AUTH_URL and NEXTAUTH_URL unset for local development. Auth.js detects
# the active host so sign-in works on localhost, 127.0.0.1, and alternate ports.

# ─── Seed admin account (used by `npm run seed`) ──────────────────────────────
ADMIN_NAME="Your Name"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"
