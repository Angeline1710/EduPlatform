generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  title        String   @default("Mr.")
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // STUDENT, ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courseEnrollments     CourseEnrollment[]
  internshipEnrollments InternshipEnrollment[]
  certificates          Certificate[]
  desiredCourses        DesiredCourse[]
  lessonProgress        LessonProgress[]
  loginLogs             LoginLog[]
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime @default(now())
  ipAddress String?
  userAgent String?
}

model DesiredCourse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String   // The topic or course name the user is interested in
  createdAt DateTime @default(now())

  @@unique([userId, topic])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  topics      String   // Tags used to match with User.DesiredCourse (comma separated)
  internRole  String   @default("Software Development") // e.g. "Frontend Development", "Data Science"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons      Lesson[]
  enrollments  CourseEnrollment[]
  certificates Certificate[]
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String   // Summary / what you will learn
  content     String   // Full lesson body
  order       Int      // Display order within the course
  createdAt   DateTime @default(now())

  progress LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model Internship {
  id          String   @id @default(cuid())
  title       String
  description String
  topics      String   // Tags to match with User.DesiredCourse (comma separated)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments  InternshipEnrollment[]
  certificates Certificate[]
}

model CourseEnrollment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
}

model InternshipEnrollment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  enrolledAt   DateTime   @default(now())
  completedAt  DateTime?

  @@unique([userId, internshipId])
}

model Certificate {
  id           String      @id @default(cuid())
  credentialId String      @unique // Custom credential ID e.g. EDU-XXXX-XXXX
  type         String      // "COURSE" | "INTERNSHIP"
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId     String?
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  internshipId String?
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  issuedAt     DateTime    @default(now())

  @@unique([userId, courseId, type])
  @@unique([userId, internshipId, type])
}
